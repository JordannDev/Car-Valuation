# Replace both placeholders before starting MySQL (local or Docker deployment).
MYSQL_PASSWORD=replace-with-local-app-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PORT=3306
MYSQL_HOST=127.0.0.1
MYSQL_USER=valueapi
MYSQL_DATABASE=valueapi
MYSQL_BUFFER_POOL_SIZE=2G
# Optional: use a preloaded MySQL data volume instead of the deployment default.
# MYSQL_DATA_VOLUME=valueapi-deploy_mysql_data
# MYSQL_DATA_VOLUME_EXTERNAL=true

# Docker deployment: Traefik's public HTTP port.
HTTP_PORT=80
HTTP_BIND_ADDRESS=0.0.0.0
# For transferred images, uncomment and set the loaded release tags.
# API_IMAGE=valueapi-api:0266518
# FRONTEND_IMAGE=valueapi-frontend:0266518
# CLI_IMAGE=valueapi-cli:0266518
# Optional API cache/calibration/projection variables also pass to the API container.
# See src/api/README.md. Leave optional numeric settings absent, not empty.

# Valuation controls (restart the API after changing).
VALUATION_HUBER_ENABLED=true
VALUATION_OUTLIER_FILTER_ENABLED=true
VALUATION_PROJECTION_ENABLED=false
